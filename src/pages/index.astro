---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BrazilIcon from "../components/BrazilIcon.astro";
import ExternalArrow from "../components/ExternalArrow.astro";
import ProfileSchema from "../components/ProfileSchema.astro";
import { profile } from "../config/profile";
import { assetPath } from "../config/deployment";
---

<Layout>
  <ProfileSchema slot="head" />
  <main class="portfolio">
    <header class="identity reveal">
      <div class="identity-heading">
        <img
          class="portrait"
          src={assetPath("/images/profile.webp")}
          alt=""
          width={52}
          height={52}
          fetchpriority="high"
          decoding="async"
        />
        <div>
          <div class="identity-name">
            <h1>{profile.name}</h1>
            <span class="nationality" role="img" aria-label="Brazil">
              <BrazilIcon size={20} />
            </span>
          </div>
          <p class="identity-role">{profile.role}</p>
        </div>
      </div>
      <p class="introduction">{profile.intro}</p>
    </header>

    <section class="work-section reveal" aria-labelledby="experience-heading">
      <h2 class="section-label" id="experience-heading">
        Experience
      </h2>
      <ol class="work-list" role="list">
        {profile.experience.map((work) => (
          <li>
            <div class="work-heading">
              <h3>
                <a
                  class="outbound-link company-link"
                  href={work.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{work.company}</span>
                  <ExternalArrow />
                </a>
              </h3>
              <p class="work-role">{work.role}</p>
              <p class="work-dates">
                <time datetime={work.start.date}>{work.start.label}</time>
                <span aria-hidden="true"> — </span>
                <span class="visually-hidden"> to </span>
                {work.end ? (
                  <time datetime={work.end.date}>{work.end.label}</time>
                ) : (
                  "Present"
                )}
              </p>
            </div>
            {work.description ? (
              <p class="work-description">{work.description}</p>
            ) : null}
          </li>
        ))}
      </ol>
    </section>

    <footer class="contact-section reveal">
      <nav aria-label="Contact and social profiles">
        <ul class="contact-links" role="list">
          {profile.links.map((link) => (
            <li>
              <a
                class="outbound-link text-link"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{link.label}</span>
                <ExternalArrow />
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </footer>
  </main>
</Layout>

---
import { profile } from "../config/profile";
import { assetPath, siteUrl } from "../config/deployment";
import fontUrl from "../assets/fonts/geist-sans.woff2?url";
import "../styles/fonts.css";
import "../styles/globals.css";

interface Props {
  noindex?: boolean;
  title?: string;
}
const { noindex = false, title = `${profile.name} — ${profile.role}` } =
  Astro.props;
const description = `${profile.name}, ${profile.role}. ${profile.intro}`;
const socialImage = `${siteUrl.replace(/\/$/, "")}/opengraph-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "max-image-preview:large"}
    />
    {!noindex && <link rel="canonical" href={siteUrl} />}
    <link rel="icon" href={assetPath("/favicon.ico")} />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={assetPath("/images/profile.webp")} as="image" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#faf9f6"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#1a1a19"
    />
    {!noindex && (
      <>
        <meta property="og:type" content="profile" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:url" content={siteUrl} />
        <meta property="og:site_name" content={profile.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={title} />
      </>
    )}
    <!-- Apply a saved preference before first paint to avoid a theme flash. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // CSS follows the system preference when storage is unavailable.
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
